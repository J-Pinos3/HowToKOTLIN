<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/introductionFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.reverb.recipechallenge.view.fragments.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/home_fragment_layout">

        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
        <action
            android:id="@+id/action_homeFragment_to_recipeFragment"
            app:destination="@id/recipeFragment" />
        <action
            android:id="@+id/action_homeFragment_to_saveFragment"
            app:destination="@id/saveFragment" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.reverb.recipechallenge.view.fragments.SearchFragment"
        android:label="SearchFragment"
        tools:layout="@layout/search_fragment_layout">

        <action
            android:id="@+id/action_searchFragment_to_saveFragment"
            app:destination="@id/saveFragment" />
        <action
            android:id="@+id/action_searchFragment_to_recipeFragment"
            app:destination="@id/recipeFragment" />
    </fragment>
    <fragment
        android:id="@+id/saveFragment"
        android:name="com.reverb.recipechallenge.view.fragments.SavedFragment"
        android:label="SavedFragment"
        tools:layout="@layout/saved_fragment_layout">

        <action
            android:id="@+id/action_saveFragment_to_recipeFragment"
            app:destination="@id/recipeFragment" />
    </fragment>
    <fragment
        android:id="@+id/introductionFragment"
        android:name="com.reverb.recipechallenge.view.fragments.IntroductionFragment"
        android:label="IntroductionFragment"
        tools:layout="@layout/introduction_fragment_layout">
        <action
            android:id="@+id/action_introductionFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/recipeFragment"
        android:name="com.reverb.recipechallenge.view.fragments.RecipeFragment"
        android:label="RecipeFragment"
        tools:layout="@layout/recipe_fragment_layout">
        <argument
            android:name="mealIdToSearch"
            app:argType="string" />
        <action
            android:id="@+id/action_recipeFragment_to_saveFragment"
            app:destination="@id/saveFragment" />
    </fragment>
</navigation>