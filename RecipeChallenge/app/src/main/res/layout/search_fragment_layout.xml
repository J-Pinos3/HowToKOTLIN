<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/llSearchBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/ibGoBack"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_arrow_backward"
                android:backgroundTint="@color/white"
                app:tint="@color/purple_dark"
                android:layout_gravity="center_vertical" />


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLookForRecipe"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:textColorHint="@color/gray">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tietLookForRecipe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_text_box"
                    android:textSize="18sp"
                    android:hint="I'm looking for?"/>
            </com.google.android.material.textfield.TextInputLayout>


            <ImageButton
                android:id="@+id/ibCancelSearch"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_clear"
                android:backgroundTint="@color/white"
                app:tint="@color/purple_dark"
                android:layout_gravity="center_vertical" />


        </LinearLayout>



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchedMeals"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/llSearchBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.core.widget.NestedScrollView>