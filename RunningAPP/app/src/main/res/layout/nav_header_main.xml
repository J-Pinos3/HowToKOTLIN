                        android:layout_height="110dp"
                        android:layout_gravity="center_horizontal"
                        android:translationZ="5dp"
                        app:cs_circle_color="@color/blue_pastel"
                        app:cs_circle_progress_color="@color/blue_trans"
                        app:cs_circle_stroke_width="8dp"
                        app:cs_circle_style="butt"
                        app:cs_disable_pointer="true"
                        app:cs_end_angle="0"
                        app:cs_max="100"
                        app:cs_negative_enabled="true"
                        app:cs_pointer_angle="0"
                        app:cs_pointer_stroke_width="8dp"
                        app:cs_progress="30"
                        app:cs_start_angle="180" />

                    <me.tankery.lib.circularseekbar.CircularSeekBar
                        android:id="@+id/csbRunsRoller"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_gravity="center_horizontal"
                        app:cs_circle_color="@color/salmon_pastel"
                        app:cs_circle_progress_color="@color/salmon_dark"
                        app:cs_circle_stroke_width="8dp"
                        app:cs_circle_style="butt"
                        app:cs_disable_pointer="true"
                        app:cs_end_angle="180"
                        app:cs_max="100"
                        app:cs_negative_enabled="true"
                        app:cs_pointer_angle="0"
                        app:cs_pointer_stroke_width="8dp"
                        app:cs_progress="30"
                        app:cs_start_angle="0" />

                    <TextView
                        android:id="@+id/tvRollerDistanceLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="DISTANCE"
                        android:textAlignment="center"
                        android:textColor="@color/gray_medium"
                        android:textSize="11sp"
                        android:layout_marginTop="15dp"/>

                    <TextView
                        android:id="@+id/tvTotalDistanceRoller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="30%"
                        android:textAlignment="center"
                        android:textColor="@color/gray_dark"
                        android:textSize="25sp"
                        android:layout_marginTop="23dp"/>

                    <TextView
                        android:id="@+id/tvTotalRunsRoller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="5/10"
                        android:textAlignment="center"
                        android:textColor="@color/gray_dark"
                        android:textSize="20sp"
                        android:layout_marginTop="55dp"/>

                    <TextView
                        android:id="@+id/tvRollerRunsLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="RUNS"
                        android:textAlignment="center"
                        android:textColor="@color/gray_medium"
                        android:textSize="11sp"
                        android:layout_marginTop="80dp"/>

                </androidx.cardview.widget.CardView>

            </RelativeLayout>

        </LinearLayout>

        <!--RUNNER -->
        <LinearLayout
            android:id="@+id/lyNavLevelRuns"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/rlHeaderLevelRuns"
                android:layout_width="wrap_content"
                android:gravity="top"
                android:layout_height="110dp">

                <TextView
                    android:id="@+id/tvNumberLevelRuns"
                    android:layout_width="117dp"
